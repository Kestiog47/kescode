# Flask 应用配置示例：复制为 .env 并按需修改
# copy .env.example .env

# 应用密钥（生产环境务必改为随机长字符串）
SECRET_KEY=dev-secret-change-me-please-replace-in-production-0123456789

# 数据库连接（默认 sqlite:///app.db，位于项目根目录）
# DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/app

# JWT 密钥（默认与 SECRET_KEY 相同）
JWT_SECRET_KEY=dev-secret-change-me-please-replace-in-production-0123456789

# 会话 Cookie 是否仅通过 HTTPS 传输（生产环境设为 true）
SESSION_COOKIE_SECURE=false

# 运行环境：development / production / testing
FLASK_ENV=development
